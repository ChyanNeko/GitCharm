    "menus": {
      "view/title": [
        {
          "command": "gitchyan.fetchAll",
          "when": "view == gitchyan.commitPanel",
          "group": "navigation@1"
        },
        {
          "command": "gitchyan.updateProject",
          "when": "view == gitchyan.commitPanel",
          "group": "navigation@2"
        },
        {
          "command": "gitchyan.push",
          "when": "view == gitchyan.commitPanel",
          "group": "navigation@3"
        },
        {
          "command": "gitchyan.syncAll",
          "when": "view == gitchyan.commitPanel",
          "group": "navigation@4"
        },
        {
          "command": "gitchyan.showBranchMenu",
          "when": "view == gitchyan.commitPanel",
          "group": "navigation@5"
        },
        {
          "command": "gitchyan.openLog",
          "when": "view == gitchyan.commitPanel",
          "group": "navigation@6"
        },
        {
          "command": "gitchyan.refreshCommitPanel",
          "when": "view == gitchyan.commitPanel",
          "group": "1_viewSort@1"
        },
        {
          "command": "gitchyan.openSettings",
          "when": "view == gitchyan.commitPanel",
          "group": "1_viewSort@2"
        },
        {
          "submenu": "gitchyan/commitPanel.fileView",
          "when": "view == gitchyan.commitPanel",
          "group": "2_viewSort@1"
        },
        {
          "submenu": "gitchyan/commitPanel.sortRepos",
          "when": "view == gitchyan.commitPanel",
          "group": "2_viewSort@2"
        },
        {
          "submenu": "gitchyan/commitPanel.reposWithoutChanges",
          "when": "view == gitchyan.commitPanel",
          "group": "2_viewSort@3"
        },
        {
          "command": "gitchyan.manageHiddenRepos",
          "when": "view == gitchyan.commitPanel",
          "group": "2_viewSort@4"
        },
        {
          "command": "gitchyan.log.fetchAndRefresh",
          "when": "view == gitchyan.gitLog",
          "group": "navigation@1"
        },
        {
          "command": "gitchyan.log.clearFilters",
          "when": "view == gitchyan.gitLog && gitchyan.logFiltersHidden && gitchyan.logFiltersActive",
          "group": "navigation@2"
        },
        {
          "command": "gitchyan.log.hideFilters",
          "when": "view == gitchyan.gitLog && !gitchyan.logFiltersHidden",
          "group": "navigation@3"
        },
        {
          "command": "gitchyan.log.showFilters",
          "when": "view == gitchyan.gitLog && gitchyan.logFiltersHidden",
          "group": "navigation@3"
        },
        {
          "command": "gitchyan.log.hideBranchSidebar",
          "when": "view == gitchyan.gitLog && !gitchyan.logSidebarHidden",
          "group": "navigation@4"
        },
        {
          "command": "gitchyan.log.showBranchSidebar",
          "when": "view == gitchyan.gitLog && gitchyan.logSidebarHidden",
          "group": "navigation@4"
        },
        {
          "command": "gitchyan.undock",
          "when": "view == gitchyan.gitLog",
          "group": "navigation@5"
        },
        {
          "command": "gitchyan.log.refresh",
          "when": "view == gitchyan.gitLog",
          "group": "1_log@1"
        },
        {
          "command": "gitchyan.setGitLogDefaultLocation",
          "when": "view == gitchyan.gitLog",
          "group": "2_log@1"
        },
        {
          "command": "gitchyan.manageHiddenRepos",
          "when": "view == gitchyan.gitLog",
          "group": "2_log@2"
        }
      ],
      "gitchyan/commitPanel.fileView": [
        {
          "command": "gitchyan.setFileViewFlat",
          "when": "gitchyan.fileViewMode != 'flat'",
          "group": "navigation@1"
        },
        {
          "command": "gitchyan.setFileViewFlatChecked",
          "when": "gitchyan.fileViewMode == 'flat'",
          "group": "navigation@1"
        },
        {
          "command": "gitchyan.setFileViewTree",
          "when": "gitchyan.fileViewMode != 'tree'",
          "group": "navigation@2"
        },
        {
          "command": "gitchyan.setFileViewTreeChecked",
          "when": "gitchyan.fileViewMode == 'tree'",
          "group": "navigation@2"
        }
      ],
      "gitchyan/commitPanel.sortRepos": [
        {
          "command": "gitchyan.sortReposByDiscovery",
          "when": "gitchyan.repoSortMode != 'discovery'",
          "group": "navigation@1"
        },
        {
          "command": "gitchyan.sortReposByDiscoveryChecked",
          "when": "gitchyan.repoSortMode == 'discovery'",
          "group": "navigation@1"
        },
        {
          "command": "gitchyan.sortReposByName",
          "when": "gitchyan.repoSortMode != 'name'",
          "group": "navigation@2"
        },
        {
          "command": "gitchyan.sortReposByNameChecked",
          "when": "gitchyan.repoSortMode == 'name'",
          "group": "navigation@2"
        },
        {
          "command": "gitchyan.sortReposByPath",
          "when": "gitchyan.repoSortMode != 'path'",
          "group": "navigation@3"
        },
        {
          "command": "gitchyan.sortReposByPathChecked",
          "when": "gitchyan.repoSortMode == 'path'",
          "group": "navigation@3"
        }
      ],
      "gitchyan/commitPanel.reposWithoutChanges": [
        {
          "command": "gitchyan.showReposWithoutChanges",
          "when": "gitchyan.hideReposWithoutChanges",
          "group": "navigation@1"
        },
        {
          "command": "gitchyan.showReposWithoutChangesChecked",
          "when": "!gitchyan.hideReposWithoutChanges",
          "group": "navigation@1"
        },
        {
          "command": "gitchyan.hideReposWithoutChanges",
          "when": "!gitchyan.hideReposWithoutChanges",
          "group": "navigation@2"
        },
        {
          "command": "gitchyan.hideReposWithoutChangesChecked",
          "when": "gitchyan.hideReposWithoutChanges",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "gitchyan.fetchAll",
          "when": "activeWebviewPanelId == gitchyan.undocked",
          "group": "navigation@1"
        },
        {
          "command": "gitchyan.updateProject",
          "when": "activeWebviewPanelId == gitchyan.undocked",
          "group": "navigation@2"
        },
        {
          "command": "gitchyan.push",
          "when": "activeWebviewPanelId == gitchyan.undocked",
          "group": "navigation@3"
        },
        {
          "command": "gitchyan.syncAll",
          "when": "activeWebviewPanelId == gitchyan.undocked",
          "group": "navigation@4"
        },
        {
          "command": "gitchyan.showBranchMenu",
          "when": "activeWebviewPanelId == gitchyan.undocked",
          "group": "navigation@5"
        },
        {
          "command": "gitchyan.log.clearFilters",
          "when": "activeWebviewPanelId == gitchyan.undocked && gitchyan.undockedLogFiltersHidden && gitchyan.undockedLogFiltersActive",
          "group": "navigation@6"
        },
        {
          "command": "gitchyan.log.hideFilters",
          "when": "activeWebviewPanelId == gitchyan.undocked && !gitchyan.undockedLogFiltersHidden",
          "group": "navigation@7"
        },
        {
          "command": "gitchyan.log.showFilters",
          "when": "activeWebviewPanelId == gitchyan.undocked && gitchyan.undockedLogFiltersHidden",
          "group": "navigation@7"
        },
        {
          "command": "gitchyan.log.hideBranchSidebar",
          "when": "activeWebviewPanelId == gitchyan.undocked && !gitchyan.undockedLogSidebarHidden",
          "group": "navigation@8"
        },
        {
          "command": "gitchyan.log.showBranchSidebar",
          "when": "activeWebviewPanelId == gitchyan.undocked && gitchyan.undockedLogSidebarHidden",
          "group": "navigation@8"
        },
        {
          "command": "gitchyan.openSettings",
          "when": "activeWebviewPanelId == gitchyan.undocked",
          "group": "navigation@9"
        }
      ],
      "scm/sourceControl": [
        {
          "command": "gitchyan.manageHiddenRepos",
          "group": "gitchyan@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gitchyan.openLog"
        },
        {
          "command": "gitchyan.showBranchMenu"
        },
        {
          "command": "gitchyan.commit"
        },
        {
          "command": "gitchyan.fetchAll"
        },
        {
          "command": "gitchyan.checkOrphanBranches"
        },
        {
          "command": "gitchyan.updateProject"
        },
        {
          "command": "gitchyan.push"
        },
        {
          "command": "gitchyan.syncAll"
        },
        {
          "command": "gitchyan.refreshCommitPanel"
        },
        {
          "command": "gitchyan.setFileViewFlat",
          "when": "false"
        },
        {
          "command": "gitchyan.setFileViewFlatChecked",
          "when": "false"
        },
        {
          "command": "gitchyan.setFileViewTree",
          "when": "false"
        },
        {
          "command": "gitchyan.setFileViewTreeChecked",
          "when": "false"
        },
        {
          "command": "gitchyan.sortReposByDiscovery",
          "when": "false"
        },
        {
          "command": "gitchyan.sortReposByDiscoveryChecked",
          "when": "false"
        },
        {
          "command": "gitchyan.sortReposByName",
          "when": "false"
        },
        {
          "command": "gitchyan.sortReposByNameChecked",
          "when": "false"
        },
        {
          "command": "gitchyan.sortReposByPath",
          "when": "false"
        },
        {
