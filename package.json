          "when": "false"
        },
        {
          "command": "gitchyan.showReposWithoutChanges",
          "when": "false"
        },
        {
          "command": "gitchyan.showReposWithoutChangesChecked",
          "when": "false"
        },
        {
          "command": "gitchyan.hideReposWithoutChanges",
          "when": "false"
        },
        {
          "command": "gitchyan.hideReposWithoutChangesChecked",
          "when": "false"
        },
        {
          "command": "gitchyan.openMergeEditor"
        },
        {
          "command": "gitchyan.manageHiddenRepos"
        },
        {
          "command": "gitchyan.manageProfiles"
