        },
        {
          "command": "gitchyan.undock"
        },
        {
          "command": "gitchyan.log.fetchAndRefresh"
        },
        {
          "command": "gitchyan.log.refresh"
        },
        {
          "command": "gitchyan.log.clearFilters"
        },
        {
          "command": "gitchyan.log.hideFilters",
          "when": "!gitchyan.logFiltersHidden"
        },
        {
          "command": "gitchyan.log.hideBranchSidebar",
          "when": "!gitchyan.logSidebarHidden"
        },
        {
          "command": "gitchyan.log.showBranchSidebar",
          "when": "gitchyan.logSidebarHidden"
        },
        {
          "command": "gitchyan.log.showFilters",
          "when": "gitchyan.logFiltersHidden"
        },
        {
          "command": "gitchyan.setGitLogDefaultLocation"
        },
        {
          "command": "gitchyan.submodule.init"
        },
        {
          "command": "gitchyan.submodule.update"
        },
        {
          "command": "gitchyan.submodule.updateRecursive"
        },
        {
          "command": "gitchyan.submodule.deinit"
        },
        {
          "command": "gitchyan.submodule.deinitForce"
        },
        {
          "command": "gitchyan.submodule.openInNewWindow"
        },
        {
          "command": "gitchyan.worktree.add"
        },
        {
          "command": "gitchyan.worktree.prune"
        },
        {
          "command": "gitchyan.openGitAnnotations",
          "when": "resourceScheme == file && config.gitchyan.gitAnnotations.enabled"
        },
        {
          "command": "gitchyan.closeGitAnnotations",
          "when": "resourceScheme == file && gitchyan.annotationsVisible"
        },
        {
          "command": "gitchyan.navigateToAnnotationCommit",
          "when": "false"
        },
        {
          "command": "gitchyan.showFileHistory",
          "when": "resourceScheme == file"
        },
        {
          "command": "gitchyan.compareWith",
          "when": "resourceScheme == file"
        },
        {
          "command": "gitchyan.commitAndPush",
          "when": "false"
        },
        {
          "command": "gitchyan.pull",
          "when": "false"
        },
        {
          "command": "gitchyan.openSettings",
          "when": "false"
        },
        {
          "command": "gitchyan.showBranchOptions",
          "when": "false"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "gitchyan.openGitAnnotations",
          "when": "resourceScheme == file && config.gitchyan.gitAnnotations.enabled && !gitchyan.annotationsVisible",
          "group": "gitchyan@1"
        },
        {
          "command": "gitchyan.closeGitAnnotations",
          "when": "resourceScheme == file && gitchyan.annotationsVisible",
          "group": "gitchyan@1"
        }
      ],
      "explorer/context": [
        {
          "submenu": "gitchyan/explorer",
          "when": "resourceScheme == file",
          "group": "gitchyan@1"
        }
      ],
      "gitchyan/explorer": [
        {
          "command": "gitchyan.showFileHistory",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "navigation@1"
        },
        {
          "command": "gitchyan.compareWith",
          "when": "resourceScheme == file",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "gitchyan.showFileHistory",
          "when": "resourceScheme == file",
          "group": "gitchyan@1"
        },
        {
          "command": "gitchyan.compareWith",
          "when": "resourceScheme == file",
          "group": "gitchyan@1"
        },
        {
          "command": "gitchyan.openMergeEditor",
          "when": "resourceScheme == file",
          "group": "gitchyan@2"
        },
        {
          "command": "gitchyan.openGitAnnotations",
          "when": "resourceScheme == file && config.gitchyan.gitAnnotations.enabled && !gitchyan.annotationsVisible",
          "group": "gitchyan@3"
        },
        {
          "command": "gitchyan.closeGitAnnotations",
          "when": "resourceScheme == file && gitchyan.annotationsVisible",
          "group": "gitchyan@3"
        }
      ]
    },
