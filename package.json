        "category": "gitchyan"
      },
      {
        "command": "gitchyan.showReposWithoutChanges",
        "title": "%command.showReposWithoutChanges.title%",
        "category": "gitchyan"
      },
      {
        "command": "gitchyan.showReposWithoutChangesChecked",
        "title": "%command.showReposWithoutChangesChecked.title%",
        "category": "gitchyan"
      },
      {
        "command": "gitchyan.hideReposWithoutChanges",
