{
  "name": "gitchyan",
  "displayName": "gitchyan",
  "description": "%extension.description%",
  "version": "0.6.0",
  "publisher": "Nekochyan",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/RioNoir/GitCharm.git"
  },
  "sponsor": {
    "url": "https://ko-fi.com/rionoir"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "scm",
    "commit",
    "log",
    "merge",
    "intellij",
    "phpstorm",
    "jetbrains",
    "pull request",
    "stash",
    "shelve",
    "changelist",
    "worktree",
    "submodule",
    "annotations",
    "ghost text"
  ],
  "icon": "media/icons/gitcharm.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "activationEvents": [
    "workspaceContains:**/.git",
    "onStartupFinished",
    "onView:gitchyan.commitPanel",
    "onView:gitchyan.gitLog",
    "onCommand:gitchyan.openLog",
    "onWebviewPanel:gitchyan.undocked",
    "onWebviewPanel:gitchyan.commitFullDetail",
    "onWebviewPanel:gitchyan.pullRequestDetail"
  ],
  "main": "./out/host/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "submenus": [
      {
        "id": "gitchyan/explorer",
        "label": "gitchyan"
      },
      {
        "id": "gitchyan/commitPanel.fileView",
        "label": "%submenu.commitPanel.fileView.label%"
      },
      {
        "id": "gitchyan/commitPanel.sortRepos",
        "label": "%submenu.commitPanel.sortRepos.label%"
      },
      {
        "id": "gitchyan/commitPanel.reposWithoutChanges",
        "label": "%submenu.commitPanel.reposWithoutChanges.label%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitchyan-commit",
          "title": "gitchyan",
          "icon": "media/icons/git-commit.svg"
        }
      ],
      "panel": [
        {
          "id": "gitchyan-log",
          "title": "%viewsContainer.gitcharm-log.title%",
          "icon": "media/icons/git-merge.svg"
        }
      ]
    },
    "views": {
      "gitchyan-commit": [
        {
          "type": "webview",
          "id": "gitchyan.commitPanel",
          "name": "gitchyan",
          "retainContextWhenHidden": true
        },
        {
          "id": "gitchyan.commitBadge",
          "name": "",
          "when": "false"
        }
      ],
      "gitchyan-log": [
        {
          "type": "webview",
          "id": "gitchyan.gitLog",
          "name": "%view.gitLog.name%",
          "retainContextWhenHidden": true,
          "when": "!gitchyan.gitLogDefaultUndocked"
        }
      ]
    },
    "commands": [
      {
        "command": "gitchyan.openLog",
        "title": "%command.openLog.title%",
        "category": "gitchyan",
        "icon": "$(history)"
      },
      {
        "command": "gitchyan.showOutputLog",
        "title": "%command.showOutputLog.title%",
        "category": "gitchyan"
      },
      {
